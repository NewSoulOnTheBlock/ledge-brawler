// spec/app/saga.md, "Story: Play five campaigns"; spec/app/saga.md, "Story: Begin again"
// The shell: the saga of spec/app/saga.md, kept in a KeyValueStore, which main.tsx makes the browser's localStorage,
// so that a campaign is still there when the page is opened again.
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Saga, type NotAnEvent, type Rejected, apply, decodeEvent, decodeState, initial, parseState } from "../gen/app__saga.effect.vibe"
import { Saved } from "./saga.schema.ts"

const KEY = "saga"

/** The store did not take the saga, which stays as it was. */
export error NotSaved { cause: unknown }

effect function saved() { return KeyValueStore.toSchemaStore(try KeyValueStore.KeyValueStore, Saved) }

/** The stored saga, or a new one where the store cannot be read or holds nothing the rules call a saga. */
export effect function load() {
  const found = (try saved()).get(KEY) catch () => Option.none()
  return decodeState(Option.getOrUndefined(found)) catch () => parseState(initial)!
}

/** The saga as last stored, and the one way to change it. */
export service Campaign {
  /** The saga now, then every later one. */
  readonly changes: Stream.Stream<Saga>
  /** `input` may come from anywhere: it is decoded into an event, and the saga it leads to is stored before it is shown. */
  receive(input: unknown): Saga!(NotAnEvent | Rejected | NotSaved)
}

/** `Campaign` from the stored saga, one input at a time. */
export const stored = Layer.effect(Campaign, effect {
  const store = try saved()
  const held = try SubscriptionRef.make(try load())
  return {
    changes: Stream.map(SubscriptionRef.changes(held), (state) => parseState(state)!),
    receive: (input) => SubscriptionRef.modifyEffect(held, effect (current) => {
      const next = try apply(current, try decodeEvent(input))
      try mapError(store.set(KEY, next), (cause) => new NotSaved({ cause }))
      return [next, parseState(next)!] as const
    })
  }
})
